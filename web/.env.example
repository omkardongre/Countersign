COUNTERSIGN_CASE_ENGINE_URL=
NEXT_PUBLIC_GOOGLE_API_KEY=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Local/dev demo aid only. Leave unset (or "false") in production so the
# case queue shows only real cases opened through intake or the Agent
# Runtime; set to "true" to seed the 3 hardcoded demo fixtures.
COUNTERSIGN_ENABLE_FIXTURES=

# Required on Vercel for keyless Workload Identity Federation to Google Cloud.
GCP_PROJECT_NUMBER=
GCP_WORKLOAD_IDENTITY_POOL_ID=
GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=
GCP_SERVICE_ACCOUNT_EMAIL=