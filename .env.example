GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=countersign-505107
GOOGLE_CLOUD_LOCATION=us-central1

# Sponsor A2A agent-card URL for /fleet/status's live Agent Registry
# read-back. The sponsor liaison runs as its own separate Cloud Run service
# (app/sponsor_liaison/), so this is recorded explicitly rather than derived
# from COUNTERSIGN_MCP_URL. Leave unset to report sponsor_liaison_agent as
# not_configured instead of guessing a hostname.
COUNTERSIGN_SPONSOR_A2A_CARD_URL=

COUNTERSIGN_COA_BACKEND=erpnext
COUNTERSIGN_SIBLING_BATCH_BACKEND=erpnext
COUNTERSIGN_ERPNEXT_TIMEOUT_SECONDS=15
# Production: prefer COUNTERSIGN_ERPNEXT_CREDENTIALS_PATH (mounted from Secret
# Manager) over the JSON env var. The path is read only inside the department
# MCP process and never logged.
COUNTERSIGN_ERPNEXT_CREDENTIALS_PATH=
COUNTERSIGN_ERPNEXT_CREDENTIALS_JSON=

COUNTERSIGN_CFI_CALENDAR_MAP_JSON={"aurex":"your-calendar-id@group.calendar.google.com"}
COUNTERSIGN_CFI_CALENDAR_ATTENDEE_MAP_JSON={"aurex":["quality-lead@yourcompany.com"]}
COUNTERSIGN_CFI_SITE_REVIEW_DELAY_HOURS=24
COUNTERSIGN_CFI_SITE_REVIEW_DURATION_MINUTES=60
COUNTERSIGN_CFI_REPORTS_FOLDER_MAP_JSON={"aurex":"your-drive-folder-id"}
# Required for Calendar attendees and Docs/Drive CFI reports; uses Workspace DWD.
COUNTERSIGN_DWD_SUBJECT=admin@yourcompany.com
COUNTERSIGN_DWD_SIGNER=department-mcp@your-project.iam.gserviceaccount.com
# Legacy aliases accepted by the deployment script.
COUNTERSIGN_CALENDAR_DWD_SUBJECT=admin@yourcompany.com
COUNTERSIGN_CALENDAR_DWD_SIGNER=department-mcp@your-project.iam.gserviceaccount.com
