# Shared GEAP resource names for Countersign (us-central1).
PROJECT_ID=countersign-505107
PROJECT_NUMBER=777448403573
ORG_ID=334195573957
LOCATION=us-central1
AGENT_GATEWAY=countersign-egress
AGENT_DISPLAY_NAME=countersign-hello
STAGING_BUCKET=gs://countersign-505107-agent-staging
GATEWAY_RESOURCE=projects/countersign-505107/locations/us-central1/agentGateways/countersign-egress

# TQA VPC + callout. networkAttachment on countersign-egress is set (immutable).
TQA_NETWORK=countersign-tqa
TQA_SUBNET_RUNTIME=countersign-tqa-runtime
TQA_SUBNET_ATTACHMENT=countersign-tqa-attachment
TQA_RUNTIME_RANGE=10.20.0.0/24
TQA_ATTACHMENT_RANGE=10.20.1.0/28
TQA_DNS_ZONE=countersign-internal
TQA_DNS_DOMAIN=countersign.internal.
TQA_FQDN=tqa.countersign.internal
TQA_CALLOUT_INSTANCE=countersign-tqa-callout
TQA_PROBE_INSTANCE=countersign-tqa-probe
TQA_NAT_ROUTER=countersign-tqa-nat-router
TQA_NAT=countersign-tqa-nat
TQA_NETWORK_ATTACHMENT=countersign-tqa-psc
TQA_IMAGE_REPO=us-central1-docker.pkg.dev/countersign-505107/countersign/tqa-callout
# e2-small was ZONE_RESOURCE_POOL_EXHAUSTED across us-central1-a/b during the spike.
TQA_ZONE=us-central1-c
TQA_MACHINE=t2d-standard-1

# Cloud SQL for ADK DatabaseSessionService + sterility_incubation.
SESSIONS_SQL_INSTANCE=countersign-sessions
SESSIONS_SQL_DB=adk_sessions
SESSIONS_SQL_IAM_USER=admin@countersign.site
INSTANCE_CONNECTION_NAME=countersign-505107:us-central1:countersign-sessions

# Case Memory (Firestore Native + vector search). Served by the department MCP SA.
CASE_MEMORY_DATABASE="(default)"
CASE_MEMORY_COLLECTION=case_memory_facts
MCP_SERVICE_ACCOUNT=countersign-department-mcp@countersign-505107.iam.gserviceaccount.com

# Dedicated public-only regulatory-screening MCP. The invoker account is
# separate from the department MCP service account and receives only
# roles/run.invoker on the screening Cloud Run service.
REGULATORY_MCP_SERVICE=countersign-regulatory-screening-mcp
REGULATORY_MCP_SERVICE_ACCOUNT=countersign-reg-mcp@countersign-505107.iam.gserviceaccount.com
REGULATORY_MCP_INVOKER_SERVICE_ACCOUNT=countersign-cfi-invoker@countersign-505107.iam.gserviceaccount.com
